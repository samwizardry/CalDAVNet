<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Package Metadata -->
    <Version>1.1.2</Version>
    <Authors>samwizardry</Authors>
    <Product>CalDAVNet</Product>
    <PackageId>CalDAVNet</PackageId>
    <Title>CalDAVNet</Title>
    <Description>A lightweight, asynchronous .NET client library for communicating with CalDAV servers (Yandex, Google, Nextcloud, Apple, etc.) compliant with CalDAV (RFC 4791), WebDAV (RFC 4918), and iCalendar (RFC 5545).</Description>
    <PackageTags>caldav;calendar;webdav;icalendar;sync;events;aspnetcore</PackageTags>
    <PackageProjectUrl>https://github.com/samwizardry/CalDAVNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/samwizardry/CalDAVNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Symbols & Documentation -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;1570;1572;1573;1574</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Ical.Net" Version="5.2.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CalDAVNet.Tests" />
  </ItemGroup>

</Project>
